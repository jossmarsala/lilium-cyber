{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "customConditions": ["source"],

    /* Path aliases — mirrors vite.config.ts resolve.alias */
    "paths": {
      "@/*": ["./src/*"],
      "@react-ui-os/core": ["./node_modules/react-ui-os/packages/core/src"],
      "@react-ui-os/desktop": ["./node_modules/react-ui-os/packages/desktop/src"],
      "@react-ui-os/theme-macos": ["./node_modules/react-ui-os/packages/theme-macos/src"],
      "@react-ui-os/theme-windows": ["./node_modules/react-ui-os/packages/theme-windows/src"],
      "@react-ui-os/theme-ubuntu": ["./node_modules/react-ui-os/packages/theme-ubuntu/src"],
      "@react-ui-os/example-apps": ["./node_modules/react-ui-os/packages/example-apps/src"],
      "@react-ui-os/icons": ["./node_modules/react-ui-os/packages/icons/src"],
      "@react-ui-os/demo": ["./node_modules/react-ui-os/packages/demo/src"]
    }
  },
  "include": ["src"]
}
