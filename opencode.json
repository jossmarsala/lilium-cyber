{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["node", "scripts/browser/mcp.ts"],
        "cwd": ".",
        "environment": {
          "BROWSER_BASE_URL": "http://localhost:5173"
        },
        "timeout": {
          "execution": 120000
        }
      }
    }
  }
}
